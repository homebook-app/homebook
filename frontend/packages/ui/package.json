{
  "name": "@homebook/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles": "./src/styles/index.ts",
    "./styles/index.scss": "./src/styles/index.scss",
    "./styles/abstracts.scss": "./src/styles/abstracts.scss"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@fontsource/roboto": "5.3.0",
    "@primeuix/themes": "catalog:",
    "primevue": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@homebook/test-utils": "workspace:*"
  }
}
