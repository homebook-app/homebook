{
  "name": "homebook-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@primeuix/themes": "2.0.3",
      "@vue/devtools-api": "8.2.1",
      "@vue/test-utils": "2.5.1",
      "pinia": "4.0.3",
      "primevue": "4.5.5",
      "vue": "3.5.43",
      "vue-i18n": "11.4.12",
      "vue-router": "4.6.4"
    }
  },
  "scripts": {
    "dev": "bun run --filter '@homebook/web' --if-present dev",
    "preview": "bun run --filter '@homebook/web' --if-present preview",
    "build": "bun run --filter '@homebook/*' --if-present build",
    "test": "bun run --filter '@homebook/*' --if-present test",
    "test:watch": "bun run --filter '@homebook/*' --if-present test:watch",
    "test:coverage": "bun run --filter '@homebook/*' --if-present test:coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '@homebook/*' --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "catalog:",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "prettier": "3.9.8",
    "sass-embedded": "1.104.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue": "catalog:",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
